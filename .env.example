# Copy to .env for local dev. docker-compose brings up Postgres matching these.

# App connection — MUST be the non-privileged meridian_app role so RLS is enforced.
# The migrate script sets this role's password to whatever you put here.
DATABASE_URL=postgres://meridian_app:app_password@localhost:5432/meridian

# Admin connection — superuser/owner. Runs migrations and the RLS canary test only.
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/meridian

# Auth
ACCESS_TOKEN_SECRET=dev-only-change-me-to-at-least-32-random-bytes

# Token vault — versioned AES-256-GCM keyring. Keys are base64 of 32 random bytes.
# The two dev keys below are throwaway (all-A / all-B); NEVER use these in production.
MERIDIAN_KEYRING={"v1":"QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=","v2":"QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI="}
MERIDIAN_KEY_CURRENT=v1

# OAuth sign-in + connect (unset for local unless testing federated login / redirect flows)
GOOGLE_CLIENT_ID=unset
APPLE_CLIENT_ID=unset
OAUTH_REDIRECT_URI=http://localhost:3000/connections/callback

# Object storage for media. Presigned uploads go browser -> storage directly, so the composer's media
# tray needs a real S3-compatible backend even in dev. Bring up MinIO + the bucket:
#   docker compose up -d minio createbuckets
# Point at localhost (not the docker hostname) so BOTH the API and the browser reach the same URL.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=meridian
S3_REGION=auto
S3_ACCESS_KEY_ID=meridian
S3_SECRET_ACCESS_KEY=localdev-minio
S3_FORCE_PATH_STYLE=true

# Runtime
PG_POOL_MAX=10
PORT=3000
NODE_ENV=development
